{
  "manifest_version": 3,
  "name": "Octopus Browser Relay",
  "version": "0.2.0",
  "key": "",
  "description": "Connect this Chrome profile to the local Octopus Browser Relay broker.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "scripting", "nativeMessaging", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "options_page": "options.html",
  "action": {
    "default_title": "Octopus Browser Relay Settings"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
